# Add these to limoagent's .env for the realtime service (limo-rt).
# DB_HOST, DB_PORT, DB_DATABASE, DB_TIMEZONE and PASSPORT_PUBLIC_KEY(_PATH) are shared
# with the chatbot and already set. Never commit real values.

# --- Database: separate accounts (docs/realtime/GRANTS.sql) ---------------------------------
RT_DB_USERNAME=limo_rt
RT_DB_PASSWORD=
# Deploy-time only (Alembic). Can be removed from .env between deploys.
RT_MIGRATE_DB_USERNAME=limo_rt_migrate
RT_MIGRATE_DB_PASSWORD=

# --- Secrets (each >= 32 random chars, all different; e.g. `openssl rand -hex 32`) ----------
# Laravel sends this in `x-secret` when it calls limo-rt; limo-rt sends it to Laravel.
# Set the same value in Laravel's NOTIFICATION_SERVICE_SECRET. NOT the old shared secret.
RT_INTERNAL_SECRET=
# Signs public tracking links.
RT_SHARE_TOKEN_SECRET=
RT_SHARE_TOKEN_MAX_HOURS=24

# --- Redis (deploy/redis-limo-rt.conf) -------------------------------------------------------
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM@127.0.0.1:6379/0

# --- Laravel (outbound SMS) ------------------------------------------------------------------
LARAVEL_API_BASE_URL=https://api.1800limo.com/api/
LARAVEL_RIDE_COMPLETED_PATH=internal/rides/{ride_id}/completed-sms

# --- Push (FCM HTTP v1): the Firebase project's service-account JSON -------------------------
FCM_PROJECT_ID=limo-2f17f
FCM_CREDENTIALS_PATH=/opt/limoagent/secrets/firebase-limo-rt.json
# FCM_TOPIC_PREFIX=production   # default: production in APP_ENV=production, else staging

# --- Licence scanning (Google Document AI): same names and values as limoRTService's .env ---
DOCUMENTAI_PROJECT_ID=
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=
# Either a service-account file (like Node's GOOGLE_APPLICATION_CREDENTIALS) or inline JSON.
GOOGLE_APPLICATION_CREDENTIALS=/opt/limoagent/secrets/documentai.json
# DOCUMENTAI_CREDENTIALS_JSON=
# DOCUMENTAI_TIMEOUT_MS=30000
# DOCUMENTAI_MAX_FILE_SIZE_BYTES=5242880
# RT_OCR_RATE_PER_MINUTE=10    # per signed-in user

# --- Browser origins allowed to call the REST API (web tracking page, admin) -----------------
RT_CORS_ORIGINS=https://1800limo.com,https://www.1800limo.com,https://admin.1800limo.com

# --- Optional tuning (defaults shown) --------------------------------------------------------
# RT_PUSH_ACK_TIMEOUT_SECONDS=5
# RT_SMS_CAP_PER_RIDE=3
# RT_TRAIL_MIN_SECONDS=10
# RT_TRAIL_MIN_METERS=25
# RT_RETENTION_ENABLED=false     # deletes trail points older than RT_RETENTION_MONTHS once on
# RT_RETENTION_MONTHS=12
