// Worked question -> SQL pairs shown to the SQL model (see examples.py). One JSON object per line.
// audience "scoped" = riders/drivers: tables already hold only their rows, so never filter by user.
// audience "admin" = platform-wide. Keep status = 'enable' on tbl_reservations (excludes deleted rows).
{"audience": "scoped", "question": "how many pending bookings do I have?", "sql": "SELECT COUNT(*) AS pending_bookings FROM tbl_reservations WHERE status = 'enable' AND booking_status = 'pending'"}
{"audience": "scoped", "question": "how many of my bookings are cancelled?", "sql": "SELECT COUNT(*) AS cancelled_bookings FROM tbl_reservations WHERE status = 'enable' AND booking_status = 'cancelled'"}
{"audience": "scoped", "question": "show my last 3 bookings", "sql": "SELECT id, pickup_date, pickup_time, COALESCE(NULLIF(pickup, ''), pickup_address) AS pickup, COALESCE(NULLIF(dropoff, ''), dropoff_address) AS dropoff, booking_status FROM tbl_reservations WHERE status = 'enable' ORDER BY created_at DESC LIMIT 3"}
{"audience": "scoped", "question": "when is my next trip?", "sql": "SELECT id, pickup_date, pickup_time, COALESCE(NULLIF(pickup, ''), pickup_address) AS pickup, COALESCE(NULLIF(dropoff, ''), dropoff_address) AS dropoff FROM tbl_reservations WHERE status = 'enable' AND pickup_date >= CURDATE() ORDER BY pickup_date, pickup_time LIMIT 1"}
{"audience": "scoped", "question": "how many trips have I completed?", "sql": "SELECT COUNT(*) AS completed_trips FROM tbl_reservations WHERE status = 'enable' AND booking_status IN ('passenger_drop', 'ended', 'finalized', 'paid', 'paid_cash', 'partial_paid')"}
{"audience": "scoped", "question": "how many bookings do I have by status?", "sql": "SELECT booking_status, COUNT(*) AS bookings FROM tbl_reservations WHERE status = 'enable' GROUP BY booking_status ORDER BY bookings DESC"}
{"audience": "admin", "question": "how many pending bookings are there?", "sql": "SELECT COUNT(*) AS pending_bookings FROM tbl_reservations WHERE status = 'enable' AND booking_status = 'pending'"}
{"audience": "admin", "question": "how many bookings were cancelled this year?", "sql": "SELECT COUNT(*) AS cancelled_bookings FROM tbl_reservations WHERE status = 'enable' AND booking_status = 'cancelled' AND YEAR(created_at) = YEAR(CURDATE())"}
{"audience": "admin", "question": "bookings by status", "sql": "SELECT booking_status, COUNT(*) AS bookings FROM tbl_reservations WHERE status = 'enable' GROUP BY booking_status ORDER BY bookings DESC"}
{"audience": "admin", "question": "how many bookings were made today?", "sql": "SELECT COUNT(*) AS bookings_today FROM tbl_reservations WHERE status = 'enable' AND DATE(created_at) = CURDATE()"}
{"audience": "admin", "question": "top 5 drivers by completed trips", "sql": "SELECT d.id, d.first_name, d.last_name, COUNT(*) AS completed_trips FROM tbl_reservations r JOIN tbl_driver_setting d ON d.id = r.driver_id WHERE r.status = 'enable' AND r.booking_status IN ('passenger_drop', 'ended', 'finalized', 'paid', 'paid_cash', 'partial_paid') GROUP BY d.id, d.first_name, d.last_name ORDER BY completed_trips DESC LIMIT 5"}
{"audience": "admin", "question": "pending bookings per vehicle type", "sql": "SELECT v.vehicle_cat_name, COUNT(*) AS pending_bookings FROM tbl_reservations r JOIN tbl_vehicle_categories v ON v.id = r.vehicle_type WHERE r.status = 'enable' AND r.booking_status = 'pending' GROUP BY v.vehicle_cat_name ORDER BY pending_bookings DESC"}
{"audience": "admin", "question": "which vehicle type is booked the most?", "sql": "SELECT v.vehicle_cat_name, COUNT(*) AS bookings FROM tbl_reservations r JOIN tbl_vehicle_categories v ON v.id = r.vehicle_type WHERE r.status = 'enable' AND r.booking_status NOT IN ('cancelled', 'rejected') GROUP BY v.vehicle_cat_name ORDER BY bookings DESC LIMIT 1"}
{"audience": "admin", "question": "how many airport transfers this month?", "sql": "SELECT COUNT(*) AS airport_transfers FROM tbl_reservations WHERE status = 'enable' AND transfer_type LIKE '%airport%' AND pickup_date >= DATE_FORMAT(CURDATE(), '%Y-%m-01') AND pickup_date < DATE_FORMAT(CURDATE(), '%Y-%m-01') + INTERVAL 1 MONTH"}
{"audience": "admin", "question": "average driver rating", "sql": "SELECT ROUND(AVG(rating), 2) AS average_rating, COUNT(*) AS ratings FROM tbl_driver_feedback"}
{"audience": "admin", "question": "how many new customers signed up this month?", "sql": "SELECT COUNT(*) AS new_customers FROM users WHERE role = 5 AND soft_delete = 0 AND created_at >= DATE_FORMAT(CURDATE(), '%Y-%m-01') AND created_at < DATE_FORMAT(CURDATE(), '%Y-%m-01') + INTERVAL 1 MONTH"}
{"audience": "admin", "question": "how many affiliates are on step 2?", "sql": "SELECT COUNT(*) AS affiliates_on_step_2 FROM tbl_affiliate_company WHERE step_completed REGEXP '(^|[^0-9])1([^0-9]|$)' AND step_completed NOT REGEXP '(^|[^0-9])2([^0-9]|$)'"}
{"audience": "admin", "question": "how many affiliates have completed step 3?", "sql": "SELECT COUNT(*) AS affiliates_completed_step_3 FROM tbl_affiliate_company WHERE step_completed REGEXP '(^|[^0-9])3([^0-9]|$)'"}
{"audience": "admin", "question": "affiliates stuck on step 4", "sql": "SELECT id, company_name, step_completed, account_approval, created_at FROM tbl_affiliate_company WHERE step_completed REGEXP '(^|[^0-9])3([^0-9]|$)' AND step_completed NOT REGEXP '(^|[^0-9])4([^0-9]|$)' ORDER BY created_at DESC LIMIT 20"}
{"audience": "admin", "question": "how many affiliates have not started onboarding steps?", "sql": "SELECT COUNT(*) AS affiliates_not_started FROM tbl_affiliate_company WHERE step_completed IS NULL OR step_completed NOT REGEXP '[0-9]'"}
{"audience": "admin", "question": "how many affiliates are approved vs still onboarding?", "sql": "SELECT account_approval, COUNT(*) AS affiliates FROM tbl_affiliate_company GROUP BY account_approval ORDER BY affiliates DESC"}
{"audience": "admin", "question": "how many bookings do I need to work on?", "sql": "SELECT COUNT(*) AS bookings_to_assign FROM tbl_reservations WHERE COALESCE(affiliate_id, 0) = 0 AND COALESCE(lose_affiliate, 0) = 0 AND booking_status NOT IN ('cancelled', 'rejected', 'refund', 'finalized', 'comped', 'non_payable') AND status = 'enable' AND pickup_date >= CURDATE()"}
{"audience": "admin", "question": "which bookings need work? (unassigned, no driver)", "sql": "SELECT id, pickup_date, pickup_time, COALESCE(NULLIF(pickup, ''), pickup_address) AS pickup, COALESCE(NULLIF(dropoff, ''), dropoff_address) AS dropoff, booking_status, payment_status FROM tbl_reservations WHERE COALESCE(affiliate_id, 0) = 0 AND COALESCE(lose_affiliate, 0) = 0 AND booking_status NOT IN ('cancelled', 'rejected', 'refund', 'finalized', 'comped', 'non_payable') AND status = 'enable' AND pickup_date >= CURDATE() ORDER BY pickup_date, pickup_time LIMIT 20"}
{"audience": "admin", "question": "unassigned bookings including past ones", "sql": "SELECT id, pickup_date, pickup_time, COALESCE(NULLIF(pickup, ''), pickup_address) AS pickup, COALESCE(NULLIF(dropoff, ''), dropoff_address) AS dropoff, booking_status, payment_status FROM tbl_reservations WHERE COALESCE(affiliate_id, 0) = 0 AND COALESCE(lose_affiliate, 0) = 0 AND booking_status NOT IN ('cancelled', 'rejected', 'refund', 'finalized', 'comped', 'non_payable') AND status = 'enable' ORDER BY pickup_date, pickup_time LIMIT 20"}
{"audience": "admin", "question": "upcoming bookings with a pending affiliate to follow up", "sql": "SELECT r.id, r.pickup_date, r.pickup_time, ac.company_name, ac.account_approval FROM tbl_reservations r JOIN tbl_affiliate_company ac ON ac.acc_id = r.affiliate_id WHERE r.is_pending_affiliate = 1 AND r.booking_status NOT IN ('cancelled', 'rejected', 'refund', 'finalized', 'comped', 'non_payable') AND r.status = 'enable' AND r.pickup_date >= CURDATE() ORDER BY r.pickup_date, r.pickup_time LIMIT 20"}
{"audience": "admin", "question": "who is the driver of booking 2096?", "sql": "SELECT r.id, CASE WHEN COALESCE(r.driver_id, 0) <> 0 THEN CONCAT_WS(' ', d.first_name, d.last_name) WHEN r.is_pending_affiliate = 1 THEN ac.company_name WHEN COALESCE(r.lose_affiliate, 0) <> 0 THEN COALESCE(NULLIF(l.name, ''), l.operator_name) END AS driver, CASE WHEN COALESCE(r.driver_id, 0) <> 0 THEN CONCAT_WS(' ', d.cell_isd, d.cell_number) WHEN r.is_pending_affiliate = 1 THEN CONCAT_WS(' ', COALESCE(ac.cell_isd, ac.dispatchisd), COALESCE(ac.cell_number, ac.dispatch)) WHEN COALESCE(r.lose_affiliate, 0) <> 0 THEN CONCAT_WS(' ', l.phone_isd, l.phone) END AS phone FROM tbl_reservations r LEFT JOIN tbl_driver_setting d ON d.id = r.driver_id LEFT JOIN tbl_affiliate_company ac ON ac.acc_id = r.affiliate_id LEFT JOIN tbl_lose_affiliates l ON l.id = r.lose_affiliate WHERE r.id = 2096"}
{"audience": "admin", "question": "total booking value this month by currency", "sql": "SELECT UPPER(o.currency) AS currency, ROUND(SUM(o.grand_total), 2) AS total, COUNT(*) AS bookings FROM tbl_reservations r JOIN tbl_order o ON o.reservation_id = r.id WHERE r.status = 'enable' AND r.booking_status NOT IN ('cancelled', 'rejected', 'refund') AND r.pickup_date >= DATE_FORMAT(CURDATE(), '%Y-%m-01') AND pickup_date < DATE_FORMAT(CURDATE(), '%Y-%m-01') + INTERVAL 1 MONTH GROUP BY UPPER(o.currency) ORDER BY total DESC"}
{"audience": "admin", "question": "how much does the affiliate get for booking 2096?", "sql": "SELECT r.id, JSON_UNQUOTE(JSON_EXTRACT(r.share_array, '$.grandTotal')) AS grand_total, JSON_UNQUOTE(JSON_EXTRACT(r.share_array, '$.affiliateShare')) AS affiliate_share, JSON_UNQUOTE(JSON_EXTRACT(r.share_array, '$.adminShare')) AS admin_share, UPPER(o.currency) AS currency FROM tbl_reservations r LEFT JOIN tbl_order o ON o.reservation_id = r.id WHERE r.id = 2096"}
{"audience": "admin", "question": "price breakdown of booking 2096", "sql": "SELECT d.rate_category, d.rate_label, d.amount, UPPER(o.currency) AS currency FROM tbl_order o JOIN tbl_order_details d ON d.order_id = o.id WHERE o.reservation_id = 2096 AND d.amount <> 0 ORDER BY FIELD(d.rate_category, 'all_inclusive_rates', 'amenities', 'misc', 'taxes', 'direct_taxes'), d.id"}
{"audience": "admin", "question": "how many bookings did travel agents make this month?", "sql": "SELECT COUNT(*) AS travel_agent_bookings FROM tbl_reservations WHERE status = 'enable' AND account_type = 'travel_planner' AND pickup_date >= DATE_FORMAT(CURDATE(), '%Y-%m-01') AND pickup_date < DATE_FORMAT(CURDATE(), '%Y-%m-01') + INTERVAL 1 MONTH"}
{"audience": "admin", "question": "how many upcoming rides are with lose affiliates?", "sql": "SELECT COUNT(*) AS lose_affiliate_rides FROM tbl_reservations WHERE status = 'enable' AND COALESCE(lose_affiliate, 0) <> 0 AND booking_status NOT IN ('cancelled', 'rejected', 'refund', 'finalized', 'comped', 'non_payable') AND pickup_date >= CURDATE()"}
{"audience": "scoped", "question": "how many bookings have I made?", "sql": "SELECT COUNT(*) AS bookings FROM tbl_reservations WHERE status = 'enable'"}
{"audience": "scoped", "question": "list my passengers with their phone numbers", "sql": "SELECT a.first_name, a.last_name, CONCAT_WS(' ', a.mobileIsd, a.mobile) AS phone, a.email, COUNT(r.id) AS bookings FROM tbl_account a JOIN tbl_reservations r ON r.travel_client_id = a.id WHERE r.status = 'enable' GROUP BY a.id, a.first_name, a.last_name, a.mobileIsd, a.mobile, a.email ORDER BY bookings DESC LIMIT 20"}
{"audience": "scoped", "question": "show my upcoming bookings with passenger names", "sql": "SELECT r.id, r.pickup_date, r.pickup_time, COALESCE(NULLIF(r.pickup, ''), r.pickup_address) AS pickup, CONCAT_WS(' ', a.first_name, a.last_name) AS passenger, r.booking_status FROM tbl_reservations r LEFT JOIN tbl_account a ON a.id = r.travel_client_id WHERE r.status = 'enable' AND r.pickup_date >= CURDATE() ORDER BY r.pickup_date, r.pickup_time LIMIT 20"}
{"audience": "admin", "question": "tell me the recent pickup dates", "sql": "SELECT id, pickup_date, pickup_time, COALESCE(NULLIF(pickup, ''), pickup_address) AS pickup FROM tbl_reservations WHERE status = 'enable' AND pickup_date <= CURDATE() ORDER BY pickup_date DESC, pickup_time DESC LIMIT 5"}
{"audience": "scoped", "question": "when was my most recent pickup?", "sql": "SELECT id, pickup_date, pickup_time, COALESCE(NULLIF(pickup, ''), pickup_address) AS pickup FROM tbl_reservations WHERE status = 'enable' AND pickup_date <= CURDATE() ORDER BY pickup_date DESC, pickup_time DESC LIMIT 1"}
{"audience": "admin", "question": "how many affiliates are in chicago?", "sql": "SELECT CASE WHEN bc.name LIKE '%chicago%' AND CONCAT_WS(' ', a.address, a.street, a.city, a.state, a.zip) LIKE '%chicago%' THEN 'Chicago badge, based in Chicago' WHEN bc.name LIKE '%chicago%' THEN 'Chicago badge, based outside Chicago' ELSE 'Based in Chicago, no Chicago badge' END AS area, SUM(ac.account_approval = 'accepted') AS approved, SUM(ac.account_approval = 'in-progress') AS onboarding, COUNT(*) AS total FROM tbl_affiliate_company ac JOIN tbl_account a ON a.id = ac.acc_id LEFT JOIN tbl_badge_cities bc ON bc.id = ac.badge_city WHERE a.status = 'enable' AND (bc.name LIKE '%chicago%' OR CONCAT_WS(' ', a.address, a.street, a.city, a.state, a.zip) LIKE '%chicago%') GROUP BY area ORDER BY total DESC"}
{"audience": "admin", "question": "list approved affiliates in chicago with their phone numbers", "sql": "SELECT ac.acc_id, COALESCE(NULLIF(ac.company_name, ''), CONCAT_WS(' ', a.first_name, a.last_name)) AS name, CONCAT_WS(' ', COALESCE(NULLIF(ac.cell_isd, ''), a.mobileIsd), COALESCE(NULLIF(ac.cell_number, ''), a.mobile)) AS phone, TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(a.address, ',', -3), ',', 1)) AS based_in, ac.account_approval, CASE WHEN bc.name LIKE '%chicago%' AND CONCAT_WS(' ', a.address, a.street, a.city, a.state, a.zip) LIKE '%chicago%' THEN 'Chicago badge, based in Chicago' WHEN bc.name LIKE '%chicago%' THEN 'Chicago badge, based outside Chicago' ELSE 'Based in Chicago, no Chicago badge' END AS area FROM tbl_affiliate_company ac JOIN tbl_account a ON a.id = ac.acc_id LEFT JOIN tbl_badge_cities bc ON bc.id = ac.badge_city WHERE a.status = 'enable' AND (bc.name LIKE '%chicago%' OR CONCAT_WS(' ', a.address, a.street, a.city, a.state, a.zip) LIKE '%chicago%') AND ac.account_approval = 'accepted' ORDER BY area, name LIMIT 20"}
{"audience": "admin", "question": "how many bookings had a pickup in chicago this month?", "sql": "SELECT COUNT(*) AS bookings FROM tbl_reservations WHERE status = 'enable' AND CONCAT_WS(' ', pickup, pickup_address) LIKE '%chicago%' AND pickup_date >= DATE_FORMAT(CURDATE(), '%Y-%m-01') AND pickup_date < DATE_FORMAT(CURDATE(), '%Y-%m-01') + INTERVAL 1 MONTH"}
{"audience": "admin", "question": "how many affiliates are in new york?", "sql": "SELECT CASE WHEN bc.name LIKE '%new york%' AND CONCAT_WS(' ', a.address, a.street, a.city, a.state, a.zip) LIKE '%new york%' THEN 'New York badge, based in New York' WHEN bc.name LIKE '%new york%' THEN 'New York badge, based outside New York' ELSE 'Based in New York, no New York badge' END AS area, SUM(ac.account_approval = 'accepted') AS approved, SUM(ac.account_approval = 'in-progress') AS onboarding, COUNT(*) AS total FROM tbl_affiliate_company ac JOIN tbl_account a ON a.id = ac.acc_id LEFT JOIN tbl_badge_cities bc ON bc.id = ac.badge_city WHERE a.status = 'enable' AND (bc.name LIKE '%new york%' OR CONCAT_WS(' ', a.address, a.street, a.city, a.state, a.zip) LIKE '%new york%') GROUP BY area ORDER BY total DESC"}
{"audience": "admin", "question": "tell me the rate for booking 2096", "sql": "SELECT d.rate_category, d.rate_label, d.amount, UPPER(o.currency) AS currency FROM tbl_order o JOIN tbl_order_details d ON d.order_id = o.id WHERE o.reservation_id = 2096 AND d.amount <> 0 ORDER BY FIELD(d.rate_category, 'all_inclusive_rates', 'amenities', 'misc', 'taxes', 'direct_taxes'), d.id"}
{"audience": "admin", "question": "how much taxes are there in booking 2096?", "sql": "SELECT d.rate_category, d.rate_label, d.amount, UPPER(o.currency) AS currency FROM tbl_order o JOIN tbl_order_details d ON d.order_id = o.id WHERE o.reservation_id = 2096 AND d.amount <> 0 AND d.rate_category IN ('taxes', 'direct_taxes') ORDER BY FIELD(d.rate_category, 'all_inclusive_rates', 'amenities', 'misc', 'taxes', 'direct_taxes'), d.id"}
{"audience": "admin", "question": "what is the grand total for booking 2096?", "sql": "SELECT r.id, o.grand_total, UPPER(o.currency) AS currency, r.booking_status FROM tbl_reservations r LEFT JOIN tbl_order o ON o.reservation_id = r.id WHERE r.id = 2096"}
{"audience": "admin", "question": "how much admin profit this month?", "sql": "SELECT UPPER(o.currency) AS currency, COUNT(*) AS bookings, SUM(CAST(COALESCE(JSON_UNQUOTE(JSON_EXTRACT(r.share_array, '$.adminShare')), 0) AS DECIMAL(12,2))) AS admin_share, SUM(CAST(COALESCE(JSON_UNQUOTE(JSON_EXTRACT(r.share_array, '$.grandTotal')), 0) AS DECIMAL(12,2))) AS grand_total, SUM(CAST(COALESCE(JSON_UNQUOTE(JSON_EXTRACT(r.share_array, '$.affiliateShare')), 0) AS DECIMAL(12,2))) AS affiliate_share, SUM(CAST(COALESCE(JSON_UNQUOTE(JSON_EXTRACT(r.share_array, '$.travelAgentShare')), 0) AS DECIMAL(12,2))) AS travel_agent_share, SUM(CAST(COALESCE(JSON_UNQUOTE(JSON_EXTRACT(r.share_array, '$.stripeFee')), 0) AS DECIMAL(12,2))) AS stripe_fee FROM tbl_reservations r JOIN tbl_order o ON o.reservation_id = r.id WHERE r.status = 'enable' AND r.booking_status NOT IN ('cancelled', 'rejected', 'refund') AND r.share_array IS NOT NULL AND r.share_array LIKE '{%' AND r.pickup_date >= DATE_FORMAT(CURDATE(), '%Y-%m-01') AND r.pickup_date < DATE_FORMAT(CURDATE(), '%Y-%m-01') + INTERVAL 1 MONTH GROUP BY UPPER(o.currency) ORDER BY bookings DESC"}
