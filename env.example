# ------------------------------------------------------------------------------
# Limo AI agent API. Copy to .env and fill in. Never commit .env.
# ------------------------------------------------------------------------------

# --- Application ---------------------------------------------------------------
# local | testing | staging | production
APP_ENV=local
LOG_LEVEL=INFO
# Browser origins allowed to call the API (comma-separated or JSON list).
# "*" allows any origin (temporary; lock down to exact widget origins before launch).
CORS_ORIGINS=*
# Server-to-server/admin key (X-Service-Key header). >= 32 chars. Never ship to frontends.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_API_KEY=
# DB introspection routes. Must be false in production.
ENABLE_DEBUG_ROUTES=false
# Serve /docs and /openapi.json. Empty = on, except in production.
EXPOSE_DOCS=
# Chat requests per user per minute (per worker until Redis is added).
RATE_LIMIT_PER_MINUTE=20
MAX_REQUEST_BODY_BYTES=524288
SSE_PING_INTERVAL_SECONDS=15
HEALTH_CHECK_TIMEOUT_SECONDS=2
# JSONL log of every chat turn (question, reply, reply type, data status, timings),
# keyed by request_id / conversation_id. Holds what users typed. Empty = off.
# e.g. ./logs/chat.jsonl
CHAT_LOG_PATH=

# --- Database: copy from the Laravel .env (same names) ---------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=limpapidb
# Use a dedicated read-only MySQL user (see README), not Laravel's account.
DB_USERNAME=limo_agent
DB_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Seconds; must stay below MySQL wait_timeout (default 28800).
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=5
DB_CONNECT_TIMEOUT=5
DB_ECHO=false
# Session time zone. Must match Laravel config/app.php 'timezone' (UTC => +00:00).
DB_TIMEZONE=+00:00
# Sets SESSION transaction_read_only=1 on every connection (defence in depth).
DB_READ_ONLY=true

# --- LLM (Ollama) --------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_TEMPERATURE=0.3
# Max seconds between streamed chunks (read timeout).
OLLAMA_TIMEOUT=120
OLLAMA_CONNECT_TIMEOUT=3
OLLAMA_MAX_CONNECTIONS=50
# Load the model in the background at startup.
OLLAMA_WARMUP=true
# Optional model just for writing SQL (e.g. qwen2.5-coder:7b; more accurate than llama3.1:8b
# at SQL). Empty = OLLAMA_MODEL. A second model needs RAM/VRAM for both.
OLLAMA_SQL_MODEL=

# --- Data questions (text-to-SQL, read only; see README) -------------------------
# Signed-in admins/sub-admins/riders/drivers can ask about their data in chat.
DATA_QUERIES_ENABLED=true
DATA_MAX_ROWS=200
# Per-query limit, enforced by MySQL (max_execution_time).
DATA_QUERY_TIMEOUT_SECONDS=5
# SQL attempts per question, including self-corrections after an error.
DATA_MAX_ATTEMPTS=3
DATA_SCHEMA_CACHE_SECONDS=900
# JSONL log of every data question + generated SQL (no result rows). Empty = off.
# e.g. ./logs/sql_queries.jsonl
DATA_QUERY_LOG_PATH=
# Learned question -> SQL pairs. A question asked before (same role, same words) reuses
# its SQL: no SQL-writing or topic-guard model call. Delete a line to unlearn it. Empty = off.
# e.g. ./data/learned_sql.jsonl
DATA_SQL_CACHE_PATH=
DATA_SQL_CACHE_MAX_ENTRIES=5000

# --- Auth: Laravel Passport -----------------------------------------------------
# Laravel signs access tokens (RS256) with storage/oauth-private.key. This service
# only needs the PUBLIC key. Set ONE of these:
#   - a path to a copy of limoapi/storage/oauth-public.key, or
#   - the PEM itself (same as Laravel's PASSPORT_PUBLIC_KEY; "\n" escapes are OK).
PASSPORT_PUBLIC_KEY_PATH=./secrets/oauth-public.key
PASSPORT_PUBLIC_KEY=
# Clock-skew allowance for exp/nbf/iat.
PASSPORT_LEEWAY_SECONDS=5
# users.role values allowed to use the API, mapped to role names (JSON).
# Roles from tbl_user_roles; all are allowed. Remove an entry to block that role.
AUTH_ALLOWED_ROLES={"1": "admin", "2": "driver", "3": "travel_agent", "4": "corporate", "5": "rider", "6": "sub_admin", "7": "sub_travel_agent", "8": "sub_affiliate", "9": "subscriber", "10": "affiliate_driver"}
# Successful verifications are cached this long (a revoked token works for at most this long).
AUTH_CACHE_TTL_SECONDS=60
AUTH_CACHE_MAX_ENTRIES=10000

# --- Booking a ride (make shell + :book, and "book a ride ..." in the web chat) ------
# The 1800limo Laravel API the web app calls (its environment.serverUrl). Bookings made
# here are real: the server sends the usual confirmation emails and texts.
LIMO_API_BASE_URL=https://api.1800limo.com/api/
# Server-side Google Maps key with Places API (New) and Directions API enabled.
# Not the web app's browser key. Never printed or logged. Without it the chat answers
# that booking isn't available.
GOOGLE_MAPS_API_KEY=
# Signed-in riders, travel agents and admins can book from /v1/chat.
CHAT_BOOKING_ENABLED=true
# A booking left idle this long is dropped (nothing was booked).
CHAT_BOOKING_TTL_SECONDS=1800
